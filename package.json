{
  "name": "git-push",
  "version": "0.1.0",
  "description": "CLI interactif pour le Git du quotidien",
  "private": true,
  "type": "module",
  "bin": "bin/git-push.js",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-pages.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node bin/git-push.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "execa": "^10.2.1",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
